
@page "/admin/permissions"
@inherits DataVanceBasePage
@using DataVance.Application.AlertServices
@using DataVance.Application.Security.DTO
@using DataVance.Application.Security.Queries
@using MediatR
@inject IStatusMessageService StatusService


<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="fw-bold"><i class="bi bi-person-lock me-2"></i> صلاحيات الوصول للفروع والأدوار</h4>
        </div>
    </div>

    @if (_data == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">جاري تحميل بيانات المستخدمين...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @* قائمة المستخدمين *@
            <div class="col-md-4">
                <div class="card fiori-card" style="height: 75vh;">
                    <div class="fiori-header">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="بحث عن مستخدم..." @bind="searchQuery" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="list-group list-group-flush overflow-auto">
                        @foreach (var user in FilteredUsers)
                        {
                            <div class="list-group-item fiori-list-item @(user.Id == _selectedUser?.Id ? "active" : "")"
                                 @onclick="() => SelectUser(user)">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3" style="width: 38px; height: 38px;">
                                        <i class="bi bi-person text-secondary"></i>
                                    </div>
                                    <div class="text-truncate">
                                        <div class="text-dark">@user.Name</div>
                                        <small class="text-muted" style="font-size: 0.75rem;">@user.AssignedBranchIds.Count فرع مرتبط</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* لوحة التحكم *@
            <div class="col-md-8">
                @if (_selectedUser != null)
                {
                    <div class="card fiori-card" style="height: 75vh;">
                        <div class="card-body overflow-auto p-4">
                            @* User Info Header *@
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div>
                                    <h5 class="mb-0 fw-bold">إدارة: @_selectedUser.Name</h5>
                                    <span class="text-muted small">المعرف الفريد: @_selectedUser.Id</span>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle @(_isRoleOpen ? "show" : "")"
                                            type="button"
                                            @onclick="ToggleRoleMenu">
                                        <i class="bi bi-shield-shaded me-1"></i> تغيير الرتبة (Role)
                                    </button>
                                    <ul class="dropdown-menu @(_isRoleOpen ? "show" : "")"
                                        style="position: absolute; right: 0; left: auto; @(_isRoleOpen ? "display: block;" : "")">
                                        <li><button class="dropdown-item" @onclick='() => ChangeRole("Admin")'>مدير نظام (Admin)</button></li>
                                        <li><button class="dropdown-item" @onclick='() => ChangeRole("Manager")'>مدير فرع (Manager)</button></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><button class="dropdown-item text-danger" @onclick='() => ChangeRole("User")'>مستخدم عادي (User)</button></li>
                                    </ul>
                                </div>
                                @* <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">
                                        تغيير الرتبة (Role)
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><button class="dropdown-item" @onclick='() => ChangeRole("Admin")'>مدير نظام (Admin)</button></li>
                                        <li><button class="dropdown-item" @onclick='() => ChangeRole("Manager")'>مدير فرع (Manager)</button></li>
                                        <li><button class="dropdown-item border-top text-danger" @onclick='() => ChangeRole("User")'>مستخدم عادي (User)</button></li>
                                    </ul>
                                </div> *@
                            </div>


                            <hr />

                            @* Branches Section *@
                            <div class="fiori-section-title"><i class="bi bi-geo-alt me-2"></i>الفروع المتاحة للربط</div>
                            <div class="row g-3">
                                @foreach (var branch in _data.AllBranches)
                                {
                                    <div class="col-md-6">
                                        <div class="fiori-switch-card d-flex justify-content-between align-items-center">
                                            <div>
                                                <span class="d-block fw-bold small">@branch.Name</span>
                                                <code class="text-muted" style="font-size: 0.7rem;">Code: @branch.Code</code>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" role="switch"
                                                       checked="@IsAssigned(branch.Id)"
                                                       @onchange="(e) => HandleToggle(branch.Id, (bool)e.Value!)">
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-light p-3 text-end">
                            <small class="text-muted"><i class="bi bi-info-circle me-1"></i> يتم حفظ التغييرات تلقائياً عند التبديل</small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card fiori-card d-flex align-items-center justify-content-center bg-light text-center" style="height: 75vh; border-style: dashed;">
                        <div>
                            <i class="bi bi-cursor fs-1 text-muted"></i>
                            <p class="mt-3 text-muted">الرجاء اختيار مستخدم من القائمة للبدء</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private UserPermissionsVm? _data;
    private UserWithBranchDto? _selectedUser;
    private string searchQuery = "";
    private bool _isRoleOpen = false;
    private void ToggleRoleMenu() => _isRoleOpen = !_isRoleOpen;
    protected override async Task OnInitializedAsync()
    {
        // استدعاء الاستعلام الموحد
        _data = await ExecuteAsync(new GetUserPermissionsManagementDataQuery());
    }

    private IEnumerable<UserWithBranchDto> FilteredUsers =>
        string.IsNullOrEmpty(searchQuery) ? _data.Users :
        _data.Users.Where(u => u.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private void SelectUser(UserWithBranchDto user) => _selectedUser = user;

    private bool IsAssigned(Guid branchId) => _selectedUser?.AssignedBranchIds.Contains(branchId) ?? false;

    private async Task HandleToggle(Guid branchId, bool isAssigned)
    {
        if (_selectedUser == null) return;

        // إرسال الأمر الموحد
        var result = await ExecuteAsync(new UpdateUserLinkBranchWithRoleCommand(_selectedUser.Id, branchId, isAssigned));

        if (result.Succeeded)
        {
            // تحديث الواجهة محلياً (Optimistic UI)
            if (isAssigned) _selectedUser.AssignedBranchIds.Add(branchId);
            else _selectedUser.AssignedBranchIds.Remove(branchId);
        }
    }

    // private async Task ChangeRole(string roleName)
    // {
    //     if (_selectedUser == null) return;
    //     await ExecuteAsync(new UpdateUserAccessCommand(_selectedUser.Id, RoleName: roleName));
    //     هنا يمكن إضافة تنبيه نجاح (Toast)
    // }
    private async Task ChangeRole(string roleName)
    {
        if (_selectedUser == null) return;

        _isRoleOpen = false; // إغلاق القائمة بعد الاختيار

        var result = await ExecuteAsync(new UpdateUserLinkBranchWithRoleCommand(_selectedUser.Id, RoleName: roleName));

        if (result.Succeeded)
        {
            StatusService.ShowMessage("تم تحديث دور المستخدم بنجاح", false);


            // يمكنك هنا إضافة تنبيه نجاح
        }
        else
        {
            StatusService.ShowMessage("خطاء في تحديث دور المستخدم بنجاح", true);

        }
    }
}

