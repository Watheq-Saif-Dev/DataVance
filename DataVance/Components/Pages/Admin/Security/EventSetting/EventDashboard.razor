@code {
    private string ActiveTab = "Events";
    private bool ShowDialog = false;
    private string DialogType = "";
    private object? SelectedModel = null;
    private EventManagementDto Data = new();

    protected override async Task OnInitializedAsync() => await LoadData();
    private async Task LoadData() => Data = await ExecuteAsync(new GetEventDashboardQuery());
    private void OpenDialog(string type, object? model = null) { DialogType = type; SelectedModel = model; ShowDialog = true; }
    private async Task CloseDialog(bool refresh) { ShowDialog = false; if (refresh) await LoadData(); }
    private async Task Delete(Guid id, string table)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "ظ‡ظ„ ط£ظ†طھ ظ…طھط£ظƒط¯ ظ…ظ† ط§ظ„ط­ط°ظپطں");
        if (confirmed)
        {
            await ExecuteAsync(new DeleteEntityCommand(id, table));
