@page "/access-denied"
@inject NavigationManager Nav

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="text-center p-5 shadow-lg rounded-4 bg-white" style="max-width: 500px; border-top: 5px solid #dc3545;">
        <div class="mb-4">
            <i class="oi oi-lock-locked text-danger" style="font-size: 5rem;"></i>
        </div>

        <h2 class="fw-bold text-dark mb-3">دخول غير مصرح!</h2>

        <p class="text-muted mb-4 fs-5">
            نعتذر، ولكن يبدو أنك لا تملك الصلاحيات الكافية للوصول إلى هذه الصفحة أو تنفيذ هذا الإجراء.
        </p>

        <div class="alert alert-light border small text-start mb-4">
            <i class="oi oi-info me-2 text-primary"></i>
            إذا كنت تعتقد أن هذا خطأ، يرجى التواصل مع مسؤول النظام لتحديث صلاحياتك.
        </div>

        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <button class="btn btn-primary px-4 py-2 fw-bold" @onclick="GoHome">
                <i class="oi oi-home me-2"></i> العودة للرئيسية
            </button>
            <button class="btn btn-outline-secondary px-4 py-2" @onclick="GoBack">
                <i class="oi oi-arrow-left me-2"></i> الصفحة السابقة
            </button>
        </div>
    </div>
</div>

@code {
    private void GoHome() => Nav.NavigateTo("/");
    private void GoBack() => Nav.NavigateTo("javascript:history.back()");
}