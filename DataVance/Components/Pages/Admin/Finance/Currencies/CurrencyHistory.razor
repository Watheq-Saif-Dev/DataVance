@page "/admin/finance/currencies/history/{CurrencyId:guid}"
@inherits DataVanceBasePage
@using DataVance.Application.Features.Currencies.DTOs
@using DataVance.Application.Features.Currencies.Queries
@using MediatR
@inject NavigationManager Nav

<div class="container mt-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-primary"><i class="bi bi-clock-history"></i> سجل أسعار الصرف</h3>
        <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/currencies")'>
            <i class="bi bi-arrow-right"></i> العودة للقائمة
        </button>
    </div>

    @if (history == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (!history.Any())
    {
        <div class="alert alert-info text-center">لا توجد سجلات تاريخية لهذه العملة بعد.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>التاريخ والوقت</th>
                            <th>سعر الصرف</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in history)
                        {
                            <tr>
                                <td>@record.EffectiveDate.ToString("yyyy/MM/dd HH:mm:ss")</td>
                                <td class="fw-bold text-success">@record.Rate.ToString("N4")</td>
                                <td><span class="badge bg-light text-dark">تحديث نظام</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid CurrencyId { get; set; }
    private List<ExchangeRateHistoryDto> history;

    protected override async Task OnInitializedAsync()
    {
        history = await ExecuteAsync(new GetExchangeRateHistoryQuery(CurrencyId));
    }
}

