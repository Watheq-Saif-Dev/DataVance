<AuditViewerModal @ref="_detailsModal" OnClose="LoadData" />

@code {
    private List<AuditLogDto> auditLogs = new();
    private List<string> tableNames = new();
    private PaginatedList<AuditLogDto>? _paginatedResult;

    private string searchUser = "";
    private string selectedTable = "";
    private string selectedAction = "";

    private int _currentPage = 0;
    private int _pageSize = 50;
    private bool _isLoading = false;
    private AuditViewerModal _detailsModal = default!;

    protected override async Task OnInitializedAsync()
    {
        if (await CheckPagePermission("ViewAuditLogs"))
        {
            // ط¬ظ„ط¨ ط£ط³ظ…ط§ط، ط§ظ„ط¬ط¯ط§ظˆظ„ ظ…ط±ط© ظˆط§ط­ط¯ط© ظپظ‚ط· ظ„طھط؛ط°ظٹط© ط§ظ„ظ€ Filter
            await LoadTableNames();
            await LoadData();
        }
    }

    private async Task LoadTableNames()
    {
        // ظٹظ…ظƒظ†ظƒ ط¬ظ„ط¨ظ‡ط§ ط¹ط¨ط± Mediator ط£ظˆ ط§ط³طھط¹ظ„ط§ظ… ط³ط±ظٹط¹ ظ‡ظ†ط§
        // tableNames = await Context.AuditLogs.Select(x => x.TableName).Distinct().ToListAsync();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            // ظ†ظ…ط±ط± selectedAction ط£ظٹط¶ط§ظ‹ ط¥ط°ط§ ط£ط¶ظپطھظ‡ط§ ظ„ظ„ظ€ Query ظˆط§ظ„ظ€ Handler
            var query = new GetAuditLogsQuery(_currentPage, _pageSize, selectedTable, searchUser);
            _paginatedResult = await ExecuteAsync(query);
            auditLogs = _paginatedResult.Items;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // --- ظ…ظ†ط·ظ‚ ط§ظ„ظپظ„طھط±ط© ط§ظ„ط¬ط¯ظٹط¯ ---

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchUser = e.Value?.ToString() ?? "";
        _currentPage = 0; // ط¥ط¹ط§ط¯ط© ط¶ط¨ط· ط§ظ„طµظپط­ط© ط¹ظ†ط¯ ط§ظ„ط¨ط­ط«
        await LoadData();
    }

    private async Task OnTableFilterChanged(ChangeEventArgs e)
    {
        selectedTable = e.Value?.ToString() ?? "";
        _currentPage = 0;
        await LoadData();
    }

    private async Task OnActionFilterChanged(ChangeEventArgs e)
    {
        selectedAction = e.Value?.ToString() ?? "";
        _currentPage = 0;
        await LoadData();
    }

    private async Task RefreshData()
    {
        _currentPage = 0;
        await LoadData();
    }

    private async Task NextPage()
    {
        if (_paginatedResult?.HasNextPage == true)
        {
            _currentPage++;
            await LoadData();
        }
    }

    private async Task PreviousPage()
    {
        if (_currentPage > 0)
        {
            _currentPage--;
            await LoadData();
        }
    }

    private string GetBadgeClass(string action) => action switch
    {
        "Create" => "sap-badge-create",
        "Update" => "sap-badge-update",
        "Delete" => "sap-badge-delete",
        _ => "bg-light text-dark border"
    };

    private string TranslateAction(string action) => action switch
    {
        "Create" => "ط¥ط¶ط§ظپط©",
        "Update" => "طھط¹ط¯ظٹظ„",
        "Delete" => "ط­ط°ظپ",
        _ => action
    };
}

