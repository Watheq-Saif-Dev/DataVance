@page "/purchase-receipts/create"
@using DataVance.Application.Common
@using DataVance.Components.Common.Business.ModelDesgin
@using DataVance.Components.Common.Business.Components
@using DataVance.Components.Shared.GenericeModal
@using DataVance.Components.Shared.AccountCompenets
@inherits DataVanceBasePage 
@inject NavigationManager NavigationManager
@inject ICurrentUserContext UserContext
@inject ILookUpService lookUpService



<CascadingValue Value="this">
    <div class="container-fluid py-3" dir="rtl">
        
        <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-2 rounded shadow-sm">
            <h4 class="text-primary m-0 fw-bold"><i class="bi bi-cart-plus-fill me-2"></i>فاتورة مشتريات جديدة</h4>
            <ActionToolbar Permissions="_pagePermissions" IsSubmitting="IsSubmitting" OnSave="OnSaveShortcut" OnClear="ClearForm" />
        </div>
        <TransactionHeader TModel="PurchaseReceiptViewModel"
                           PartnerTitle="المورد"
                           PartnerName="@SelectedVendorName"
                           IsVendor ="true"
                           AccountId="@SelectedAccountId"
                           FinancialAccountName="@ReceiptModel.FinancialAccountName"
                           WarehouseName="@ReceiptModel.WarehouseName"
                           CurrencyName="@ReceiptModel.CurrCode"
                           ExchangeRate="@ReceiptModel.ExchangeRate"
                           OnPartnerSelected="HandleVendorSelection"
                           OnFinancialAccountSelected="OnFinancialAccountSelected"
                           OnWarehouseSelected="HandleHeaderWarehouseSelected"
                           OnPaymentMethodUpdated="HandlePaymentMethodChange"
                           OnCurrencySelected="HandleCurrencySelection"
                           
                            />
        <div class="row justify-content-center mb-4">
            <div class="col-12 col-md-8 col-lg-5">
                <BarcodeScanner OnBarcodeRead="ProcessBarcode" />
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-xl-9">
                <div class="shadow-sm rounded-3 bg-white">
                    <SharedItemsGrid TItem="ReceiptItemDtoViewModel"
                                     Items="@ReceiptModel.Items"
                                     DefaultWarehouseId="@ReceiptModel.DefaultWarehouseId"
                                     DefaultWarehouseName="@ReceiptModel.WarehouseName"
                                     IsSales="false"
                                     IsPurchase="true"
                                     OnDataChanged="StateHasChanged" />
                </div>
            </div>

            <div class="col-12 col-xl-3">
                <div class="sticky-top" style="top: 20px; z-index: 1020;">
                    <div class="card shadow border-0 rounded-3 bg-light">
                        <div class="card-body p-3">
                            <h6 class="fw-bold mb-3 border-bottom pb-2 text-secondary text-center">
                                <i class="bi bi-calculator-fill me-2"></i>ملخص الحسابات
                            </h6>

                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">إجمالي الأصناف:</span>
                                <span class="fw-bold">@ReceiptModel.Items.Sum(x => x.Quantity * x.UnitPriceOrCost).ToString("N2")</span>
                            </div>
                            
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">خصم الأصناف:</span>
                                <span class="text-danger fw-bold">- @ReceiptModel.Items.Sum(x => x.DiscountAmountForAllQty).ToString("N2")</span>
                            </div>

                            <div class="p-2 bg-white rounded border-start border-danger border-3 mb-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">خصم إضافي:</span>
                                    <input type="number" class="form-control form-control-sm text-end text-danger fw-bold border-0 p-0 w-50"
                                           @bind="ReceiptModel.HeaderDiscount" @bind:event="oninput" />
                                </div>
                            </div>

                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted small">إجمالي الضرائب:</span>
                                <span class="text-dark fw-bold">@ReceiptModel.Items.Sum(x => x.TotalTax).ToString("N2")</span>
                            </div>

                            <div class="text-center p-3 bg-primary text-white rounded-3 shadow">
                                <div class="small opacity-75 mb-1">صافي الفاتورة النهائي</div>
                                <h2 class="fw-bolder mb-0">
                                    <span class="fs-6 fw-normal">@ReceiptModel.CurrCode</span>
                                    @CalculateFinalTotal().ToString("N2")
                                </h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</CascadingValue>
<LookupModal @ref="GenericModal" OnItemSelected="HandleItemSelected" />




