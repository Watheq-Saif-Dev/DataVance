@code {
    [Parameter] public string Type { get; set; } = "";
    [Parameter] public object? Model { get; set; }
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    private List<string> AvailableCommands = new();
    private List<SystemEventDto> SystemEvents = new();

    // ط§ظ„ظƒظˆظ…ط§ظ†ط¯ط² ط§ظ„ظ…ط­ط¯ط«ط© ط¨ظ€ set ظ„طھظ‚ط¨ظ„ ط§ظ„ظ€ Binding
    private UpsertSystemEventCommand eventCmd = new();
    private UpsertTriggerCommand triggerCmd = new();
    private UpsertPermissionCommand permissionCmd = new(); // طھط£ظƒط¯ ظ…ظ† ط¨ظ†ط§ط، ظ‡ط°ط§ ط§ظ„ظ€ Command

    protected override async Task OnInitializedAsync()
    {
        var res = await ExecuteAsync(new GetEventDashboardQuery());
        AvailableCommands = res.AvailableCommands;
        SystemEvents = res.Events;
    }

 
    protected override void OnParametersSet()
    {
        if (Model == null)
        {
            // ط¥ط°ط§ ظƒط§ظ† Model ظپط§ط±ط؛ط§ظ‹طŒ ظپظ‡ط°ط§ ظٹط¹ظ†ظٹ "ط¥ط¶ط§ظپط© ط¬ط¯ظٹط¯ط©" ظپظ†ظ‚ظˆظ… ط¨طھطµظپظٹط± ط§ظ„ظƒظˆظ…ط§ظ†ط¯ط²
            eventCmd = new();
            triggerCmd = new();
            permissionCmd = new();
            return;
        }

        if (Type == "Event" && Model is SystemEventDto e)
        {
            eventCmd = new UpsertSystemEventCommand
            {
                Id = e.Id,
                Code = e.Code,
                DisplayName = e.DisplayName,
                Module = e.Module,
                IsActive = e.IsActive
            };
        }
        else if (Type == "Trigger" && Model is EventTriggerDto t)
        {
            triggerCmd = new UpsertTriggerCommand
            {
                Id = t.Id,
                OperationCode = t.OperationCode,
                SystemEventId = t.SystemEventId,
                ExecutionOrder = t.ExecutionOrder
            };
        }
  
        else if (Type == "Permission" && Model is EventPermissionDto p)
        {
            permissionCmd = new UpsertPermissionCommand
            {
                Id = p.Id,
                TargetId = p.TargetId,
                TargetType = Enum.Parse<PermissionTarget>(p.TargetType),
                SystemEventId = p.SystemEventId,
                BranchId = p.BranchId,
                WarehouseId = p.WarehouseId,
                IsGranted = p.IsGranted,
                MaxAmount = p.MaxAmount // ط§ظ„ط­ظ‚ظ„ ط§ظ„ظ…ط§ظ„ظٹ ط§ظ„ط°ظٹ ط£ط¶ظپطھظ‡
            };
        }
    }
    // private async Task HandleSave()
    // {
    //     if (Type == "Event") await ExecuteAsync(eventCmd);
    //     else if (Type == "Trigger") await ExecuteAsync(triggerCmd);
    //     else if (Type == "Permission") await ExecuteAsync(permissionCmd);
    //     await OnClose.InvokeAsync(true);
    // }
    private async Task HandleSave()
    {
        Console.WriteLine($"[DEBUG] HandleSave Started for Type: {Type}");

        if (Type == "Trigger")
        {
            Console.WriteLine($"[DEBUG] Sending Trigger: Op={triggerCmd.OperationCode}, EventId={triggerCmd.SystemEventId}");
            var result = await ExecuteAsync(triggerCmd);
            Console.WriteLine($"[DEBUG] Save Result ID: {result}");
        }
        else if (Type == "Event") await ExecuteAsync(eventCmd);
        else if (Type == "Permission") await ExecuteAsync(permissionCmd);

        await OnClose.InvokeAsync(true);
    }
}

