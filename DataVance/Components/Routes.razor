
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        @* إذا لم يسجل دخوله أصلاً، حوله لصفحة الدخول *@
                        <RedirectToLogin />
                    }
                    else
                    {
                        @* إذا سجل دخوله ولكن يحاول دخول صفحة ليست من صلاحياته *@
                        <div class="alert alert-warning m-5 text-center">
                            <i class="bi bi-exclamation-triangle"></i>
                            عذراً، ليس لديك صلاحية للوصول إلى هذه الصفحة.
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="text-center p-5">جاري التحقق من الهوية...</div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>غير موجود</PageTitle>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <p role="alert" class="text-center p-5">عذراً، هذا العنوان غير صحيح.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>