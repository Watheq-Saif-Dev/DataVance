@code {
    [Parameter] public bool IsCollapsed { get; set; }
    private string _activeMenu = "";
    private bool IsGlobalLoading = false;

    protected override void OnInitialized()
    {
        StatusService.OnLoadingStateChanged += HandleLoadingStateChanged;
    }

    private void HandleLoadingStateChanged(bool isLoading)
    {
        IsGlobalLoading = isLoading;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        StatusService.OnLoadingStateChanged -= HandleLoadingStateChanged;
    }

    private void ToggleMenu(string menuName)
    {
        if (_activeMenu == menuName)
        {
            _activeMenu = "";
        }
        else
        {
            _activeMenu = menuName;
        }
    }
}
