@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject ICurrentUserContext currentUser

@if (currentUser.IsAuthenticated)
{
    @* أضفنا كلاس "mobile-mode" إذا كانت الشاشة صغيرة (اختياري) *@
    <div class="erp-layout @(_sidebarCollapsed ? "sidebar-collapsed" : "")">
        <header class="erp-header shadow-sm px-2 px-md-3">
            <div class="header-left d-flex align-items-center">
                <button class="btn btn-lg btn-link text-dark me-2" @onclick="ToggleSidebar">
                    <i class="bi bi-list"></i>
                </button>
                <a class="navbar-brand fw-bold text-primary d-none d-sm-block" href="/">DataVance</a>
            </div>

            <div class="header-right d-flex align-items-center gap-3">
                @* Badge الفرع بتنسيق أنيق *@
                <div class="d-flex align-items-center gap-2 bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill small fw-bold">
                    <i class="bi bi-geo-alt-fill"></i>
                    <span>@currentUser.BranchName</span>
                </div>

                <div class="dropdown">
                 
                    <button class="btn border-0 d-flex align-items-center gap-2 p-1" type="button" @onclick="ToggleUserMenu">
                        <div class="avatar-circle bg-secondary-subtle text-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="bi bi-person-fill fs-5"></i>
                        </div>
                        <div class="text-start d-none d-md-block">
                            <div class="fw-bold small" style="line-height: 1;">@currentUser.UserName</div>
                            <small class="text-muted" style="font-size: 10px;">مسؤول النظام</small>
                        </div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow @(_userMenuOpen ? "show" : "")"
                        style="display: @(_userMenuOpen ? "block" : "none"); position: absolute; right: 0; min-width: 200px;">
                        <li><a class="dropdown-item py-3" href="/profile"><i class="bi bi-person me-2"></i> الملف الشخصي</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item py-3 text-danger" href="api/auth/logout"><i class="bi bi-box-arrow-right me-2"></i> تسجيل الخروج</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <div class="erp-body">
          
            @if (!_sidebarCollapsed)
            {
                <div class="sidebar-backdrop d-md-none" @onclick="ToggleSidebar"></div>
            }
            
            <aside class="erp-sidebar shadow-sm">
                <NavMenu IsCollapsed="_sidebarCollapsed" />
            </aside>

            <main class="erp-main">
                <div class="erp-content px-2 px-md-4 py-3">
                    @Body
                </div>
                <footer class="erp-footer border-top bg-white px-3 py-1">
                    <StatusBar />
                </footer>
            </main>
        </div>
    </div>
}
else
{
    <div class="login-layout">
        @Body
    </div>
}

@code {
    private bool _userMenuOpen = false;
    private bool _sidebarCollapsed = true; // ابدأ بها مفتوحة للكمبيوتر

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                // محاولة فحص القياس، إذا فشل (JS غير موجود) سيبقى على الوضع الافتراضي
                var dimension = await JSRuntime.InvokeAsync<WindowDimension>("getWindowDimensions");
                if (dimension.Width < 768)
                {
                    _sidebarCollapsed = true; // في الموبايل ابدأ بها مخفية
                    StateHasChanged();
                }
            }
            catch { /* تجنب انهيار الصفحة إذا لم يجد الدالة */ }
        }
    }

    public class WindowDimension { public int Width { get; set; } }
    private void ToggleUserMenu() => _userMenuOpen = !_userMenuOpen;
    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;
}   